# ============================================================
# AgentPME FastAPI Backend - Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# Application
APP_NAME=AgentPME API
APP_ENV=development  # development, staging, production
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=info  # debug, info, warning, error, critical

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
API_KEY_HEADER=X-API-Key

# CORS - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================================
# AI Providers - OpenRouter (Primary, same as Next.js)
# ============================================================

# OpenRouter API Key (used for both LLM and Embeddings)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# LLM Model (any model supported by OpenRouter)
# Examples: openai/gpt-3.5-turbo, openai/gpt-4, anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=openai/gpt-3.5-turbo
OPENROUTER_TEMPERATURE=0.3
OPENROUTER_MAX_TOKENS=1024

# Embeddings (via OpenRouter, proxied to OpenAI)
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ============================================================
# Database - Supabase
# ============================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key  # For client-side operations
SUPABASE_SERVICE_KEY=your-service-role-key  # For backend operations
SUPABASE_JWT_SECRET=your-jwt-secret  # For validating JWT tokens

# Database connection (optional - for direct SQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/agentpme

# ============================================================
# Vector Search (pgvector)
# ============================================================

VECTOR_MATCH_THRESHOLD=0.8
VECTOR_MATCH_COUNT=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ============================================================
# WhatsApp (Meta Cloud API)
# ============================================================

WHATSAPP_ACCESS_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_API_VERSION=v18.0

# ============================================================
# n8n Automation Webhooks
# ============================================================

N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/agentpme-hot-lead
N8N_ENABLED=true
N8N_TIMEOUT_SECONDS=5

# ============================================================
# External Services
# ============================================================

# For webhook calls to Next.js frontend
NEXTJS_API_URL=http://localhost:3000
NEXTJS_API_KEY=shared-secret-between-services

# Stripe (for webhook validation)
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================
# Monitoring (optional)
# ============================================================

SENTRY_DSN=
PROMETHEUS_ENABLED=false

# ============================================================
# Testing
# ============================================================

TESTING=false
TEST_SUPABASE_URL=
TEST_SUPABASE_KEY=
